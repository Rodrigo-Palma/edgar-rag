# Every variable carries the EDGAR_RAG_ prefix. Unset ones take the default shown.

# --- Ingestion ---------------------------------------------------------------
# The SEC requires every automated request to identify itself with a real
# contact. https://www.sec.gov/os/webmaster-faq#developers
EDGAR_RAG_EDGAR_USER_AGENT="Your Name your.email@example.com"

# --- Shared by ingestion, service and evaluation -----------------------------
# Ollama serves both models locally; nothing leaves the machine.
EDGAR_RAG_OLLAMA_BASE_URL="http://localhost:11434"
EDGAR_RAG_EMBEDDING_MODEL="nomic-embed-text"
# Where the ingestion writes the index and the service reads it.
EDGAR_RAG_INDEX_DIR="data/index"

# --- Service -----------------------------------------------------------------
EDGAR_RAG_GENERATION_MODEL="qwen3:32b"
# The checks before the model is asked: none, cosine or period+cosine.
# "period" declines a question about a year the filing does not report; the
# default needs nothing but the index.
EDGAR_RAG_GATE="period+cosine"
# An answer is only returned when the best passage clears this cosine score.
EDGAR_RAG_MIN_RETRIEVAL_SCORE="0.55"
# Generations allowed at once; past this, /ask answers 503 instead of queueing.
EDGAR_RAG_MAX_CONCURRENT_GENERATIONS="2"
# A request still running after this many seconds is answered with 504.
EDGAR_RAG_REQUEST_TIMEOUT_SECONDS="90"
# No authentication and no rate limit: keep the service on this machine.
EDGAR_RAG_HOST="127.0.0.1"
EDGAR_RAG_PORT="8000"
