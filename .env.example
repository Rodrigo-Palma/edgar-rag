# The SEC requires every automated request to identify itself.
# https://www.sec.gov/os/webmaster-faq#developers
EDGAR_USER_AGENT="Your Name your.email@example.com"

# Ollama serves both models locally; nothing leaves the machine.
OLLAMA_BASE_URL="http://localhost:11434"
EMBEDDING_MODEL="nomic-embed-text"
GENERATION_MODEL="qwen3:32b"

# An answer is only returned when the best passage clears this cosine score.
MIN_RETRIEVAL_SCORE="0.55"
